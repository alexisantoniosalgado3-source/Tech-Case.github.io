<script>

function showCostGroup(key,btn){
 document.querySelectorAll('.cost-group').forEach(group=>group.style.display='none');
 const target=document.getElementById('cost-'+key);
 if(target) target.style.display='block';
 document.querySelectorAll('.cost-tab').forEach(tab=>tab.classList.remove('active'));
 btn.classList.add('active');
}

function showSection(id){
 document.getElementById('home').style.display='none';
 document.querySelectorAll('.content').forEach(x=>x.classList.remove('active'));
 document.getElementById(id).classList.add('active');
 document.getElementById('search').value='';
 document.getElementById('empty').style.display='none';
 window.scrollTo({top:0,behavior:'smooth'});
}
function goHome(){
 document.querySelectorAll('.content').forEach(x=>x.classList.remove('active'));
 document.getElementById('home').style.display='block';
 document.getElementById('search').value='';
 document.getElementById('empty').style.display='none';
 window.scrollTo({top:0,behavior:'smooth'});
}
function filterCards(id,cat,btn){
 const root=document.getElementById(id);
 root.querySelectorAll('.info').forEach(card=>card.style.display=(cat==='all'||card.dataset.cat===cat)?'block':'none');
 btn.parentElement.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
 btn.classList.add('active');
}
function searchContent(){
 const q=document.getElementById('search').value.toLocaleLowerCase('es');
 const active=document.querySelector('.content.active');
 const home=document.getElementById('home');
 let found=0;
 if(active){
  active.querySelectorAll('.info').forEach(card=>{
   const match=card.innerText.toLocaleLowerCase('es').includes(q);
   card.style.display=match?'block':'none'; if(match)found++;
  });
 }else{
  home.querySelectorAll('.info').forEach(card=>{
   const match=card.innerText.toLocaleLowerCase('es').includes(q);
   card.style.display=match?'block':'none'; if(match)found++;
  });
 }
 document.getElementById('empty').style.display=(q && found===0)?'block':'none';
}
function calculate(){
 const n=id=>Number(document.getElementById(id).value)||0;
 const net=n('ventas')-n('costo')-n('gastos')-n('fin')-n('impuesto');
 document.getElementById('calcresult').textContent='Utilidad neta: '+net.toLocaleString('es-MX',{style:'currency',currency:'MXN'});
}
</script>
